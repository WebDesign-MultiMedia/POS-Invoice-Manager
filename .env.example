# Copy to .env.local (frontend key) and fill in the backend keys in your
# Vercel project's Environment Variables settings — never commit real keys.

# Frontend — safe to expose, this is the publishable key (starts with pk_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Backend only (used by api/create-payment-intent.js) — never prefix with
# VITE_, never commit, never put in frontend code
STRIPE_SECRET_KEY=sk_test_...

# Backend only (used by api/sheets.js) — the SheetDB API id and its Basic
# Auth credentials (SheetDB dashboard → API → Settings). Never prefix with
# VITE_; the browser only ever talks to /api/sheets.
SHEETDB_ID=your_sheetdb_api_id
SHEETDB_USER=
SHEETDB_PASS=

# Backend only (used by api/send-broadcast.js) — Twilio credentials for the
# customer text broadcast. Set TWILIO_MESSAGING_SERVICE_SID (the Messaging
# Service your A2P 10DLC campaign is attached to); TWILIO_PHONE_NUMBER
# (+1...) is used only if no Messaging Service is set.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=MG...
TWILIO_PHONE_NUMBER=

# Backend only (used by api/send-broadcast.js) — must equal the
# SIGNUP_SIGNING_KEY secret on the BLFM website's consent Worker. The
# broadcast only texts SMSSignups rows signed with it.
SIGNUP_SIGNING_KEY=

# Password managers type on the /broadcast page; the endpoint refuses to send
# without it. Use something long — anyone with it can text every customer.
BROADCAST_PASSWORD=
