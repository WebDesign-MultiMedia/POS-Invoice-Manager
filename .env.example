# Every environment variable the app reads. Copy to .env.local for local
# development (npm run dev + npm run dev:api) and set the same names in
# Vercel → Project → Settings → Environment Variables. Never commit real
# values. Only VITE_ variables reach the browser, so nothing secret may
# start with VITE_.

# ---- Frontend (public) ----
# Stripe publishable key (pk_live_… / pk_test_…); safe in the browser.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# ---- Backend only: staff login (api/_lib/auth.js) ----
# JSON map of login (email or 10-digit phone) → password hash from `npm run hash-password`.
STAFF_ACCOUNTS={"owner@example.com":"<salt>:<hash>"}
# Signs login cookies and invoice share links; make with `openssl rand -hex 32` (changing it logs everyone out).
SESSION_SECRET=replace-with-64-hex-characters
# Optional. The Catering Calculator's no-login employee link is signed with
# this version; change it (e.g. to 2) to turn off every link already sent.
CALCULATOR_LINK_VERSION=1

# ---- Backend only: order storage (api/sheets.js, api/send-broadcast.js) ----
# SheetDB API id for the order spreadsheet.
SHEETDB_ID=your_sheetdb_api_id
# SheetDB Basic Auth username (SheetDB dashboard → API → Settings).
SHEETDB_USER=your_sheetdb_user
# SheetDB Basic Auth password.
SHEETDB_PASS=your_sheetdb_password
# Full Google Sheets URL the staff "Open spreadsheet" button redirects to (api/sheet-link.js).
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_sheet_id/edit

# ---- Backend only: card payments (api/create-payment-intent.js, api/receipt-url.js) ----
# Stripe secret key (sk_live_… / sk_test_…).
STRIPE_SECRET_KEY=sk_test_placeholder

# ---- Backend only: SMS broadcast (api/send-broadcast.js) ----
# Twilio account SID (starts with AC).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio auth token.
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Messaging Service SID (MG…) your A2P 10DLC campaign uses; preferred sender.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Fallback sender number (+1…), used only when no Messaging Service is set.
TWILIO_PHONE_NUMBER=+15555550100
# Must equal SIGNUP_SIGNING_KEY on the website's SMS-consent Worker; only rows signed with it are texted.
SIGNUP_SIGNING_KEY=replace-with-shared-signing-key

# ---- Backend only: receipt photos on Shopping lists (api/shopping.js) ----
# Optional. A PRIVATE Vercel Blob store (Vercel → Storage → Create → Blob,
# access: Private) connected to this project; Vercel adds BLOB_STORE_ID and
# the app signs in with the project's automatic OIDC token. Locally, use
# BLOB_READ_WRITE_TOKEN instead. Without either, "Scan receipt" is hidden.
BLOB_STORE_ID=store_placeholder
# Optional. Claude API key (console.anthropic.com → API keys) so Shopping
# reads each receipt photo: store, date, items and total. A few cents per
# receipt. Without it, photos are kept but not read.
ANTHROPIC_API_KEY=sk-ant-placeholder

# ---- Backend only: Zelle auto-confirm on Event Sales (api/zelle-alerts.js) ----
# Optional. Without these, the Zelle screen works by hand as before.
# Resend API key with Full access (it reads received emails).
RESEND_API_KEY=re_placeholder
# The private Resend receiving address Gmail forwards Chase's Zelle emails to,
# e.g. zelle-<random>@<id>.resend.app. Only mail sent to this exact address counts.
ZELLE_INBOUND_ADDRESS=zelle-replace-with-random@your-id.resend.app
