# Copy to .env.local (frontend key) and fill in the backend keys in your
# Vercel project's Environment Variables settings — never commit real keys.

# Frontend — safe to expose, this is the publishable key (starts with pk_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Backend only (used by api/create-payment-intent.js) — never prefix with
# VITE_, never commit, never put in frontend code
STRIPE_SECRET_KEY=sk_test_...

# Backend only (used by api/sheets.js) — the SheetDB API id and its Basic
# Auth credentials (SheetDB dashboard → API → Settings). Never prefix with
# VITE_; the browser only ever talks to /api/sheets.
SHEETDB_ID=your_sheetdb_api_id
SHEETDB_USER=
SHEETDB_PASS=
